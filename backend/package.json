{
  "name": "@lexihive/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs --backend",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node --env-file-if-exists=.env dist/src/index.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma db push --skip-generate && tsx --env-file-if-exists=.env prisma/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=.env prisma/seed.ts",
    "payments:reconcile": "tsx --env-file-if-exists=.env src/jobs/reconcile-payments.ts",
    "payments:check": "tsx --env-file-if-exists=.env src/jobs/check-payments.ts",
    "dev:all": "node scripts/dev.mjs",
    "setup": "node scripts/setup.mjs",
    "predev": "node scripts/generate-client.mjs",
    "prebuild": "node scripts/generate-client.mjs",
    "pretypecheck": "node scripts/generate-client.mjs",
    "lint": "eslint --config eslint.config.js src shared",
    "pretest": "node scripts/generate-client.mjs",
    "test": "tsx --test shared/*.test.ts test/*.test.ts",
    "pretest:integration": "node scripts/generate-client.mjs && node scripts/test-database.mjs",
    "test:integration": "tsx --test test/integration.ts test/billing.integration.ts",
    "db:start": "node scripts/database.mjs",
    "db:backup": "node scripts/backup.mjs",
    "db:check": "node scripts/check-database.mjs",
    "db:resolve-atlas": "node scripts/resolve-atlas.mjs",
    "security:scan": "node scripts/security-scan.mjs",
    "admin:provision": "tsx --env-file-if-exists=.env src/jobs/provision-admin.ts"
  },
  "dependencies": {
    "@prisma/client": "6.12.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "mongodb": "^6.20.0",
    "nodemailer": "^10.2.1",
    "stripe": "^19.1.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^24.10.0",
    "@types/nodemailer": "^7.0.3",
    "@types/supertest": "^6.0.3",
    "prisma": "6.12.0",
    "supertest": "^7.1.4",
    "@eslint/js": "^10.0.0",
    "eslint": "^10.0.0",
    "globals": "^17.0.0",
    "prettier": "^3.9.10",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.2"
  }
}
