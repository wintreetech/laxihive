# Application
DATABASE_URL=mongodb://127.0.0.1:27018/lexihive?replicaSet=lexihive-local
APP_ORIGIN=http://localhost:5174
PORT=4000
NODE_ENV=development
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters
REQUIRE_EMAIL_VERIFICATION=false
ADMIN_EMAIL=support@lexihive.com
SUPPORT_EMAIL=support@lexihive.com

# One switch for new purchases. Keep false while awaiting this website's merchant approval.
# Fill the credentials, confirm merchant-approved currencies, then set true and restart/redeploy.
PAYMENTS_ENABLED=false
MEMBER_ID=
WORKING_KEY=
# Verification tokens are generated automatically from the merchant credentials.

# Enable only currencies approved for this merchant.
TW_SUPPORTED_CURRENCIES=USD,EUR
TW_ENVIRONMENT=live
# Use your public HTTPS backend URL when deploying. Callback paths are derived automatically.
PUBLIC_API_URL=http://localhost:4000
PAYMENT_MODE=CC
PAYMENT_BRAND=VISA
# Development only. Production requires public HTTPS callbacks.
TW_ALLOW_LOCAL_CHECKOUT=false

# Add optional SMTP, FX, test-database or maintenance settings only when needed.
# See backend/docs/ENVIRONMENT.md.
