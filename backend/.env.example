DATABASE_URL=mongodb://127.0.0.1:27018/lexihive?replicaSet=lexihive-local
# Tests never derive their target from the application's database URL.
TEST_DATABASE_URL=mongodb://127.0.0.1:27018/lexihive_test?replicaSet=lexihive-local
PORT=4000
# Frontend address. Vite reads this host/port too; do not edit a second port in vite.config.js.
APP_ORIGIN=http://localhost:5174
NODE_ENV=development
# Use a random secret of at least 32 characters; hash sessions remain server-side.
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
# New stores seed 100 coins per USD and EUR. Edit each rate in Admin > Pricing.
ADMIN_EMAIL=
# Full email address required. Leave blank until the business supplies one.
SUPPORT_EMAIL=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYMENTS_ENABLED=false
PAYMENT_PROVIDER=transactworld
TW_ENVIRONMENT=live
# Optional override; must match the selected environment's documented origin.
TW_GATEWAY_ORIGIN=
PUBLIC_API_URL=http://localhost:4000
MEMBER_ID=
WORKING_KEY=
TO_TYPE=Transactworld
LANGUAGE=ENG
PAYMENT_BRAND=VISA
PAYMENT_MODE=CC
# Restrict to currencies enabled by your merchant. Example: EUR or USD,EUR.
TW_SUPPORTED_CURRENCIES=USD,EUR
# Optional Backoffice Inquiry API token. Standard hosted checkout uses WORKING_KEY.
TW_AUTH_TOKEN=
# Production requires an operational token and public HTTPS callbacks.
PAYMENT_RECONCILIATION_ENABLED=true
PAYMENT_RECONCILIATION_SECONDS=60
# Development only: allow a localhost browser return. Ignored in production.
TW_ALLOW_LOCAL_CHECKOUT=false
# Leave blank to derive backend callback routes from PUBLIC_API_URL above.
# Set these only if you intentionally use different public callback addresses.
MERCHANT_REDIRECT_URL=
NOTIFICATION_URL=
# Live Stripe keys are deliberately rejected. Review tax and business setup before enabling live commerce.
STRIPE_AUTOMATIC_TAX=false
