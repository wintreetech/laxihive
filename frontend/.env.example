VITE_API_URL=/api
# On Render Static Sites, configure these Rewrites in order:
# /api/* -> https://laxihive-backend.onrender.com/api/*
# /* -> /index.html
# Set API_PROXY_TARGET in Netlify build settings (server origin, no trailing /api).
# The build emits a same-origin proxy so secure session cookies work with a separate Node host.
